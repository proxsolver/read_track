# Database Configuration
DATABASE_URL=mysql://user:password@localhost:3306/read_track

# Session Secret (use a long random string in production)
SESSION_SECRET=change-this-to-a-random-secret-key

# Environment
NODE_ENV=development

# Server Port
PORT=5000

# Google OAuth Configuration (required for authentication)
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# 알라딘 도서 검색 API (책 표지 및 정보 가져오기)
# 무료로 발급 가능: https://www.aladin.co.kr/ttb/wblog_managettbkey.aspx
ALADIN_API_KEY=ttbdlengus11691003001

# Optional: AWS S3 Configuration (if using S3 for file uploads)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=ap-northeast-2
# AWS_S3_BUCKET=your-bucket-name

