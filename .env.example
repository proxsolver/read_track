# Database Configuration
DATABASE_URL=mysql://user:password@localhost:3306/read_track

# Session Secret (use a long random string in production)
SESSION_SECRET=change-this-to-a-random-secret-key

# Environment
NODE_ENV=development

# Server Port
PORT=5000

# OAuth Configuration (required for multi-device sync)
# Get these from your OAuth provider
VITE_OAUTH_PORTAL_URL=https://your-oauth-portal.com
VITE_APP_ID=your-app-id

# Optional: AWS S3 Configuration (if using S3 for file uploads)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=ap-northeast-2
# AWS_S3_BUCKET=your-bucket-name
